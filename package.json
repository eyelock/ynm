{
  "name": "@ynm/root",
  "version": "0.0.0",
  "private": true,
  "description": "ynm: your named memory. Agent memory in git notes, exposed over MCP and CLI.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "format": "biome format . --write",
    "lint": "biome lint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "bench": "pnpm --filter @ynm/evals bench",
    "gate": "pnpm --filter @ynm/evals gate",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "release:version": "changeset version && pnpm install --no-frozen-lockfile",
    "gen:clients": "node scripts/gen-clients.mjs",
    "docs:gen": "node scripts/gen-docs.mjs",
    "docs:links": "node scripts/gen-docs.mjs --check-links",
    "release:slim": "node scripts/release/build-slim.mjs",
    "bench:public": "pnpm --filter @ynm/evals bench:public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^3.0.3",
    "esbuild": "^0.28.2",
    "postject": "1.0.0-alpha.6",
    "turbo": "^2.9.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
