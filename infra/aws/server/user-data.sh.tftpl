#!/bin/bash
# First boot of a ynm store server (Amazon Linux 2023, arm64). Installs Docker, mounts the data
# volume, and installs two systemd units: ynm.service (the server and Caddy, started on every
# boot) and ynm-backup.timer (a git bundle to S3). Nothing here is state: the data volume is.
set -euo pipefail
exec > >(tee -a /var/log/ynm-setup.log) 2>&1

dnf install -y docker jq
systemctl enable --now docker

# The data volume. Terraform attaches it after the server starts, so wait for it. It is found by
# volume id, mounted by label, and formatted only if it has no filesystem: a volume moved from an
# old server is never wiped.
dev="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${replace(volume_id, "-", "")}"
for _ in $(seq 1 120); do [ -e "$dev" ] && break; sleep 5; done
[ -e "$dev" ] || { echo "data volume ${volume_id} never attached" >&2; exit 1; }
if ! blkid "$dev" >/dev/null 2>&1; then
  mkfs.xfs -L ynm-data "$dev"
fi
mkdir -p /data
grep -q 'LABEL=ynm-data' /etc/fstab || echo 'LABEL=ynm-data /data xfs defaults,nofail 0 2' >> /etc/fstab
mount -a
mountpoint -q /data
mkdir -p /data/ynm /data/caddy/data /data/caddy/config /etc/ynm
# The ynm image runs as uid 1001; a store written by an earlier (root) image is handed over too.
chown -R 1001:1001 /data/ynm

# Non-secret settings. Secrets come from SSM at every start (ynm-up below).
cat > /etc/ynm/ynm.env <<'ENV'
%{ for k, v in server_env ~}
${k}=${v}
%{ endfor ~}
ENV

cat > /etc/ynm/Caddyfile <<'CADDY'
{
	email ${acme_email}
}

${hostname} {
	reverse_proxy ynm:3000
}
CADDY

cat > /usr/local/bin/ynm-up <<'UP'
#!/bin/bash
# Start the server and Caddy. Refuses to serve if the server reports no authentication.
set -euo pipefail
mountpoint -q /data || { echo "/data is not mounted" >&2; exit 1; }

install -d -m 700 /run/ynm
aws ssm get-parameters-by-path --region ${region} --path "${env_path}" --with-decryption \
    --query 'Parameters[].[Name,Value]' --output text |
  while IFS=$'\t' read -r name value; do
    if [ -n "$name" ] && [ "$value" != "unset" ]; then printf '%s=%s\n' "$${name##*/}" "$value"; fi
  done > /run/ynm/secrets.env
chmod 600 /run/ynm/secrets.env

%{ if registry_param != "" ~}
creds="$(aws ssm get-parameter --region ${region} --name "${registry_param}" --with-decryption \
  --query Parameter.Value --output text)"
if [ "$creds" != "unset" ]; then
  printf '%s' "$${creds#*:}" | docker login ${registry} --username "$${creds%%:*}" --password-stdin
fi
%{ endif ~}
for _ in 1 2 3 4 5; do docker pull ${image} && break; sleep 10; done
docker pull caddy:2

docker network inspect ynm >/dev/null 2>&1 || docker network create ynm
docker rm -f caddy ynm >/dev/null 2>&1 || true

docker run -d --name ynm --network ynm --restart unless-stopped \
  --env-file /etc/ynm/ynm.env --env-file /run/ynm/secrets.env \
  -v /data/ynm:/data \
  --log-driver awslogs --log-opt awslogs-region=${region} \
  --log-opt awslogs-group=${log_group} --log-opt awslogs-stream=ynm \
  ${image}%{ for a in server_args } '${a}'%{ endfor }

# The server must be up, and must not be open, before anything can reach it.
auth=""
for _ in $(seq 1 60); do
  auth="$(docker exec ynm wget -qO- http://127.0.0.1:3000/health 2>/dev/null | jq -r '.auth // empty' || true)"
  [ -n "$auth" ] && break
  sleep 2
done
case "$auth" in
  "") echo "ynm did not answer /health" >&2; docker rm -f ynm; exit 1 ;;
  none|local-token) echo "ynm reports auth '$auth': refusing to expose it" >&2; docker rm -f ynm; exit 1 ;;
esac

docker run -d --name caddy --network ynm --restart unless-stopped \
  -p 80:80 -p 443:443 \
  -v /etc/ynm/Caddyfile:/etc/caddy/Caddyfile:ro \
  -v /data/caddy/data:/data -v /data/caddy/config:/config \
  --log-driver awslogs --log-opt awslogs-region=${region} \
  --log-opt awslogs-group=${log_group} --log-opt awslogs-stream=caddy \
  caddy:2
UP

cat > /usr/local/bin/ynm-down <<'DOWN'
#!/bin/bash
# Stop Caddy first so no request arrives mid-shutdown, then give the server time to flush.
docker stop caddy >/dev/null 2>&1 || true
docker stop --time 60 ynm >/dev/null 2>&1 || true
docker rm -f caddy ynm >/dev/null 2>&1 || true
DOWN

cat > /usr/local/bin/ynm-backup <<'BACKUP'
#!/bin/bash
# A git bundle of the store to S3. A store on the sqlite provider has no repository to bundle;
# its volume snapshots are its backup.
set -euo pipefail
[ -d /data/ynm/store.git ] || { echo "no git store to bundle"; exit 0; }
name="store-$(date -u +%Y-%m-%dT%H%MZ).bundle"
docker exec ynm git -C /data/store.git bundle create "/data/$name" --all
aws s3 cp --region ${region} "/data/ynm/$name" "s3://${backup_bucket}/${client}/$name"
rm -f "/data/ynm/$name"
BACKUP

chmod 755 /usr/local/bin/ynm-up /usr/local/bin/ynm-down /usr/local/bin/ynm-backup

cat > /etc/systemd/system/ynm.service <<'UNIT'
[Unit]
Description=ynm hosted store (${client})
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
RequiresMountsFor=/data

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/ynm-up
ExecStop=/usr/local/bin/ynm-down
TimeoutStartSec=600
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
UNIT

cat > /etc/systemd/system/ynm-backup.service <<'UNIT'
[Unit]
Description=Bundle the ynm store to S3
Requires=ynm.service
After=ynm.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ynm-backup
UNIT

cat > /etc/systemd/system/ynm-backup.timer <<'UNIT'
[Unit]
Description=Weekly ynm store bundle

[Timer]
OnCalendar=${backup_schedule}
Persistent=true

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable ynm.service ynm-backup.timer
systemctl start ynm-backup.timer
systemctl start ynm.service
