{
  "name": "@ynm/service",
  "version": "0.3.0",
  "private": true,
  "description": "The one business layer: mounts, remember, recall, consolidate, sync, doctor (ADR-008).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hook-intent": {
      "types": "./dist/hooks/intent.d.ts",
      "import": "./dist/hooks/intent.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@ynm/index": "workspace:*",
    "@ynm/model": "workspace:*",
    "@ynm/models": "workspace:*",
    "@ynm/store": "workspace:*",
    "@ynm/store-s3": "workspace:*",
    "@ynm/wiki": "workspace:*",
    "zod": "^4.3.6",
    "@ynm/telemetry": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@ynm/typescript-config": "workspace:*",
    "@ynm/vitest-config": "workspace:*",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
