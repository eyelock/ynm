{
  "name": "@ynm/mcp",
  "version": "0.2.0",
  "private": true,
  "description": "MCP server: tools, resources, prompts, stdio and Streamable HTTP transports (ADR-008, ADR-009).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lambda": {
      "types": "./dist/lambda.d.ts",
      "import": "./dist/lambda.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "node scripts/version.mjs && tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "node scripts/version.mjs && tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "@ynm/model": "workspace:*",
    "@ynm/service": "workspace:*",
    "@ynm/index": "workspace:*",
    "zod": "^4.3.6",
    "@ynm/store": "workspace:*",
    "@ynm/wiki": "workspace:*",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@ynm/typescript-config": "workspace:*",
    "@ynm/vitest-config": "workspace:*",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^5.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "@modelcontextprotocol/client": "^2.2.0"
  },
  "bin": {
    "ynm-mcp": "./bin/run.js"
  }
}
