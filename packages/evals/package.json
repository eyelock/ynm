{
  "name": "@ynm/evals",
  "version": "0.3.1",
  "private": true,
  "description": "Standing evals and milestone gates (ADR-014). Tier 1 runs on every PR.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --exclude 'src/gates/**' --exclude 'src/tier1/latency/**' --exclude 'src/tier2/**' --exclude 'src/tier1/hosted/**' --exclude 'src/tier3/public-benchmarks.test.ts'",
    "test:coverage": "vitest run --coverage --exclude 'src/gates/**' --exclude 'src/tier1/latency/**' --exclude 'src/tier2/**' --exclude 'src/tier1/hosted/**' --exclude 'src/tier3/public-benchmarks.test.ts'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo coverage",
    "bench": "vitest run src/tier1/latency --reporter=verbose",
    "gate": "node scripts/gate.mjs",
    "test:hosted": "vitest run src/tier1/hosted --reporter=verbose",
    "bench:public": "vitest run src/tier3/public-benchmarks.test.ts --reporter=verbose",
    "test:tutorials": "vitest run src/tier1/tutorials --reporter=verbose",
    "eval:tutorials": "vitest run src/tier2/tutorials --reporter=verbose",
    "eval:hosted-remember": "vitest run src/tier2/guidance/hosted-remember.live.eval.test.ts --reporter=verbose"
  },
  "dependencies": {
    "@ynm/model": "workspace:*",
    "@ynm/store": "workspace:*",
    "@ynm/service": "workspace:*",
    "fast-check": "^4.6.0",
    "@ynm/index": "workspace:*",
    "@modelcontextprotocol/client": "^2.2.0",
    "@ynm/models": "workspace:*",
    "@ynm/wiki": "workspace:*",
    "@ynm/store-s3": "workspace:*",
    "@aws-sdk/client-s3": "^3.1144.0"
  },
  "devDependencies": {
    "@ynm/typescript-config": "workspace:*",
    "@ynm/vitest-config": "workspace:*",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^5.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
